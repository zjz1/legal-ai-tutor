# ============ 运行配置（复制为 .env 后按需修改，切勿提交真实密钥） ============

# 模型提供方：mock（离线骨架，默认）| ollama（本地）| openai（云端 OpenAI 兼容）
LLM_PROVIDER=mock

# ---- 本地 Ollama ----
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=legal-qwen
# 开发阶段建议用小模型加速联调，验收时换回 legal-qwen
# LOCAL_MODEL=qwen2.5:1.5b

# ---- 云端（OpenAI 兼容：DeepSeek / 通义 / Kimi / vLLM 均可）----
CLOUD_API_BASE=https://api.deepseek.com/v1
CLOUD_API_KEY=
CLOUD_MODEL=deepseek-chat

# ---- 预算与容错 ----
REQUEST_TIMEOUT=25
TOTAL_DEADLINE=60
MAX_CONCURRENCY=1
RETRIES=3
CIRCUIT_FAILURES=5
CIRCUIT_COOLDOWN=60

# ---- 服务安全 ----
# 留空 = 不鉴权（仅本机开发）；生产环境务必设置
API_TOKEN=
RATE_LIMIT_PER_MINUTE=30

# ---- 路径与日志 ----
LAW_DIR=data/laws
LOG_LEVEL=INFO

# ---- 前端是否显示「云端 Key 输入框」（默认关闭，Key 只从服务端读）----
ALLOW_CLIENT_KEY=false
